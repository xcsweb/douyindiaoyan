{
  "$comment": "motion-kit 标准控件清单：给渲染器校验输入、给助手选控件、给文档生成目录用。控件实现见 src/controls/*.js。时间（cues）一律是成片绝对秒数，可省略，省略时控件按自身节奏排布。 变体：每段可写 variant 指定；不写时同一控件在片中第 1、2、3 次出现依次用 variants 的第 1、2、3 个，循环。",
  "version": "0.3.0",
  "transitions": ["cut", "flash", "wipe", "blur", "zoom", "whip", "glitch", "iris", "shutter", "pixel", "dip"],
  "controls": {
    "title": {
      "label": "两行标题",
      "use": "开场、段落开头：一行陈述 + 一行重点（重点行砸入）",
      "props": {
        "kicker": {
          "type": "string",
          "max": 32,
          "label": "标题上方小字"
        },
        "line1": {
          "type": "string",
          "max": 16,
          "required": true,
          "label": "第一行"
        },
        "line2": {
          "type": "string",
          "max": 16,
          "label": "第二行（渐变色，砸入）"
        }
      },
      "cues": {
        "count": 2,
        "meaning": [
          "第一行入场",
          "第二行砸入"
        ]
      },
      "minDur": 2.5,
      "variants": [
        "slam",
        "split",
        "type"
      ],
      "variantsNote": "slam 砸入 / split 左右滑入 + 光线 / type 逐字打出 + 遮罩"
    },
    "keyword": {
      "label": "关键词砸入",
      "use": "一个词或短语是这段话的重点；后面可以补 1–3 句解释，逐句出现",
      "props": {
        "kicker": {
          "type": "string",
          "max": 32
        },
        "word": {
          "type": "string",
          "max": 10,
          "required": true,
          "label": "关键词"
        },
        "sub": {
          "type": "array",
          "of": "string",
          "max": 28,
          "minItems": 0,
          "maxItems": 3,
          "label": "补充说明（逐句出现）"
        }
      },
      "cues": {
        "count": "1 + sub.length",
        "meaning": [
          "关键词砸入",
          "每句补充"
        ]
      },
      "minDur": 2,
      "variants": [
        "slam",
        "glitch",
        "focus"
      ],
      "variantsNote": "slam 砸入 + 火花 / glitch 干扰闪烁 / focus 模糊聚焦 + 取景框"
    },
    "number": {
      "label": "数字滚动",
      "use": "一个关键数字：时长、数量、百分比、价格。可带 1–3 句注释",
      "props": {
        "label": {
          "type": "string",
          "max": 20,
          "required": true
        },
        "value": {
          "type": "number",
          "required": true
        },
        "from": {
          "type": "number"
        },
        "decimals": {
          "type": "integer",
          "min": 0,
          "max": 2
        },
        "prefix": {
          "type": "string",
          "max": 3
        },
        "unit": {
          "type": "string",
          "max": 6
        },
        "note": {
          "type": "array",
          "of": "string",
          "max": 24,
          "minItems": 0,
          "maxItems": 3
        }
      },
      "cues": {
        "count": "1 + note.length",
        "meaning": [
          "开始滚动（1.4 秒到达）",
          "每句注释"
        ]
      },
      "minDur": 3,
      "variants": [
        "ring",
        "gauge",
        "flip"
      ],
      "variantsNote": "ring 环形进度 / gauge 半圆仪表 / flip 逐位翻入 + 刻度"
    },
    "list": {
      "label": "要点列表",
      "use": "1–6 个并列要点，逐条出现；全部出现后高亮依次轮转",
      "props": {
        "title": {
          "type": "string",
          "max": 18,
          "required": true
        },
        "items": {
          "type": "array",
          "of": "string",
          "max": 24,
          "minItems": 1,
          "maxItems": 6,
          "required": true
        }
      },
      "cues": {
        "count": "items.length",
        "meaning": [
          "每条要点"
        ]
      },
      "minDur": 3,
      "variants": [
        "rail",
        "cards",
        "check"
      ],
      "variantsNote": "rail 竖轨编号 / cards 玻璃卡翻起 / check 方框打勾"
    },
    "compare": {
      "label": "左右对比",
      "use": "两种做法、前后变化、A 和 B 的差别；可给结论并标出胜者",
      "props": {
        "left": {
          "type": "object",
          "required": true,
          "props": {
            "label": {
              "type": "string",
              "max": 12
            },
            "big": {
              "type": "string",
              "max": 10,
              "required": true
            },
            "lines": {
              "type": "array",
              "of": "string",
              "max": 18,
              "maxItems": 3
            }
          }
        },
        "right": {
          "type": "object",
          "required": true,
          "props": {
            "label": {
              "type": "string",
              "max": 12
            },
            "big": {
              "type": "string",
              "max": 10,
              "required": true
            },
            "lines": {
              "type": "array",
              "of": "string",
              "max": 18,
              "maxItems": 3
            }
          }
        },
        "verdict": {
          "type": "string",
          "max": 16
        },
        "winner": {
          "type": "enum",
          "values": [
            "left",
            "right",
            "none"
          ]
        }
      },
      "cues": {
        "count": 3,
        "meaning": [
          "左边出现",
          "右边出现",
          "结论"
        ]
      },
      "minDur": 4,
      "variants": [
        "split",
        "panels",
        "flip"
      ],
      "variantsNote": "split 两侧滑入 / panels 玻璃面板 / flip 先单侧再翻出另一侧"
    },
    "steps": {
      "label": "步骤流程",
      "use": "2–5 个先后步骤；光点沿轨道依次点亮",
      "props": {
        "title": {
          "type": "string",
          "max": 18
        },
        "steps": {
          "type": "array",
          "of": "string",
          "max": 10,
          "minItems": 2,
          "maxItems": 5,
          "required": true
        }
      },
      "cues": {
        "count": "steps.length",
        "meaning": [
          "每一步点亮"
        ]
      },
      "minDur": 3.5,
      "variants": [
        "track",
        "ladder",
        "cards"
      ],
      "variantsNote": "track 轨道光点 / ladder 阶梯上升 / cards 卡片接力"
    },
    "quote": {
      "label": "金句 / 引用",
      "use": "一句原话、观点或引用，逐字打出；*星号* 包住的词高亮",
      "props": {
        "text": {
          "type": "string",
          "max": 60,
          "required": true
        },
        "who": {
          "type": "string",
          "max": 24
        }
      },
      "cues": {
        "count": 1,
        "meaning": [
          "开始打字"
        ]
      },
      "minDur": 3,
      "variants": [
        "type",
        "reveal",
        "card"
      ],
      "variantsNote": "type 逐字打出 / reveal 短语浮现 + 下划线 / card 玻璃卡翻入"
    },
    "bars": {
      "label": "数据条",
      "use": "2–5 项数值比较；数值必须来自真实数据",
      "props": {
        "title": {
          "type": "string",
          "max": 18,
          "required": true
        },
        "unit": {
          "type": "string",
          "max": 6
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "required": true,
          "of": "object",
          "props": {
            "label": {
              "type": "string",
              "max": 12,
              "required": true
            },
            "value": {
              "type": "number",
              "required": true
            }
          }
        },
        "max": {
          "type": "number"
        }
      },
      "cues": {
        "count": "items.length",
        "meaning": [
          "每条数据增长"
        ]
      },
      "minDur": 3,
      "variants": [
        "rows",
        "columns",
        "rank"
      ],
      "variantsNote": "rows 横条 / columns 竖柱 / rank 排序 + 第一名高亮"
    },
    "media": {
      "label": "录屏 / 图片窗",
      "use": "展示用户的录屏、截图、产品图；可在画面上标出 1–3 处重点",
      "props": {
        "title": {
          "type": "string",
          "max": 24,
          "label": "窗口标题"
        },
        "src": {
          "type": "media",
          "label": "视频、图片或 %05d 图片序列（相对时间轴文件）"
        },
        "sourceStart": {
          "type": "number",
          "min": 0,
          "label": "视频从第几秒开始"
        },
        "callouts": {
          "type": "array",
          "of": "object",
          "maxItems": 3,
          "props": {
            "text": {
              "type": "string",
              "max": 16,
              "required": true
            },
            "x": {
              "type": "number",
              "min": 0,
              "max": 1,
              "required": true
            },
            "y": {
              "type": "number",
              "min": 0,
              "max": 1,
              "required": true
            }
          }
        }
      },
      "cues": {
        "count": "1 + callouts.length",
        "meaning": [
          "窗口入场",
          "每个标注"
        ]
      },
      "minDur": 3,
      "variants": [
        "tilt",
        "zoom",
        "scan"
      ],
      "variantsNote": "tilt 透视转入 / zoom 推近标注处 / scan 扫描刷出"
    },
    "stamp": {
      "label": "印章强调",
      "use": "下结论、表态：免费、已上线、不推荐",
      "props": {
        "text": {
          "type": "string",
          "max": 8,
          "required": true
        },
        "sub": {
          "type": "string",
          "max": 30
        },
        "tone": {
          "type": "enum",
          "values": [
            "warm",
            "ok",
            "bad"
          ]
        }
      },
      "cues": {
        "count": 1,
        "meaning": [
          "盖章"
        ]
      },
      "minDur": 1.8,
      "variants": [
        "stamp",
        "badge",
        "neon"
      ],
      "variantsNote": "stamp 盖章 / badge 圆徽章旋入 / neon 霓虹点亮"
    },
    "chapter": {
      "label": "章节卡",
      "use": "长视频分段：编号 + 段名",
      "props": {
        "no": {
          "type": "string",
          "max": 4,
          "required": true
        },
        "name": {
          "type": "string",
          "max": 14,
          "required": true
        },
        "sub": {
          "type": "string",
          "max": 30
        }
      },
      "cues": {
        "count": 1,
        "meaning": [
          "段名入场"
        ]
      },
      "minDur": 1.8,
      "variants": [
        "outline",
        "center",
        "wipe"
      ],
      "variantsNote": "outline 描边编号 / center 居中 + 两侧光线 / wipe 色带扫过"
    },
    "fusion": {
      "label": "光球合成",
      "use": "A × B 合在一起得到结果 C",
      "props": {
        "line": {
          "type": "string",
          "max": 16
        },
        "a": {
          "type": "string",
          "max": 12,
          "required": true
        },
        "b": {
          "type": "string",
          "max": 12,
          "required": true
        },
        "result": {
          "type": "string",
          "max": 18,
          "required": true
        }
      },
      "cues": {
        "count": 2,
        "meaning": [
          "两颗球出现",
          "合成爆闪"
        ]
      },
      "minDur": 3.5,
      "variants": [
        "orbs",
        "orbit",
        "collide"
      ],
      "variantsNote": "orbs 牵引合成 / orbit 绕转收拢 / collide 高速相撞"
    }
  }
}