{
  "controls": {
    "logo": {
      "label": "Logo 揭示",
      "use": "片头或片尾亮出品牌/频道标志：有 logo 图片就用图片，没有就用名字首字或图标生成字标；下方可带一句标语",
      "props": {
        "name": { "type": "string", "max": 16, "required": true, "label": "品牌/频道名（字标）" },
        "tagline": { "type": "string", "max": 24, "label": "标语" },
        "src": { "type": "media", "label": "logo 图片（方形最佳，可省略）" },
        "icon": { "type": "icon", "label": "无图片时的标志图标（省略则用名字首字）" }
      },
      "cues": { "count": 2, "meaning": ["标志揭示（爆闪 / 描线 / 定格）", "标语出现"] },
      "minDur": 3, "tail": 1.6, "idle": true,
      "variants": ["burst", "draw", "glitch"],
      "variantsNote": "burst 粒子旋入汇聚后爆闪弹出 / draw 外框描线后填色、字标擦出 / glitch 错位色散干扰后定格"
    },
    "intro": {
      "label": "片头",
      "use": "视频开头的节目标题卡：标题 + 副标题 + 可选期数/日期。电影感开场、系列节目、栏目包装",
      "props": {
        "title": { "type": "string", "max": 14, "required": true, "label": "标题" },
        "subtitle": { "type": "string", "max": 28, "label": "副标题" },
        "episode": { "type": "string", "max": 12, "label": "期数/日期（如 EP.07、第 3 期）" }
      },
      "cues": { "count": 2, "meaning": ["标题出现", "副标题出现"] },
      "minDur": 3, "tail": 1.6, "idle": true,
      "variants": ["cinema", "bold", "minimal"],
      "variantsNote": "cinema 遮幅黑边打开 + 光带扫过 + 字距收拢 / bold 色块弹出 + 巨大期数 + 标题升起 / minimal 中线画出、标题上升副标题下落、四角括号"
    },
    "outro": {
      "label": "片尾",
      "use": "视频结尾：感谢语 + 1–3 个下一步（推荐视频、下期预告、关注/链接文字），可带头像",
      "props": {
        "thanks": { "type": "string", "max": 10, "required": true, "label": "感谢语" },
        "sub": { "type": "string", "max": 24, "label": "感谢语下方小字" },
        "items": { "type": "array", "of": "object", "minItems": 1, "maxItems": 3, "required": true, "label": "下一步（endcard 前两项做推荐位，next 第一项做预告卡）",
          "props": { "text": { "type": "string", "max": 14, "required": true }, "src": { "type": "media", "label": "推荐位/预告卡画面（可省略）" } } },
        "avatar": { "type": "media", "label": "头像（可省略）" },
        "name": { "type": "string", "max": 12, "label": "频道名" },
        "follow": { "type": "string", "max": 6, "label": "endcard 关注按钮文字（默认 关注）" }
      },
      "cues": { "count": "1 + items.length", "meaning": ["感谢语出现", "每个下一步出现"] },
      "minDur": 4, "tail": 1.4, "idle": true,
      "variants": ["endcard", "thanks", "next"],
      "variantsNote": "endcard 推荐位方框描边 + 头像 + 关注按钮呼吸 / thanks 巨大感谢语弹落 + 彩纸炮 + 胶囊 / next 下期预告卡三维摆入 + 自动播放进度环"
    },
    "cta": {
      "label": "行动号召",
      "use": "引导观众做一个动作：点链接、领取、评论、往下看、上滑。一个按钮文字 + 一句补充",
      "props": {
        "kicker": { "type": "string", "max": 20 },
        "text": { "type": "string", "max": 10, "required": true, "label": "按钮/号召文字" },
        "sub": { "type": "string", "max": 24, "label": "补充一句" },
        "icon": { "type": "icon", "label": "按钮图标（button / swipe）" },
        "dir": { "type": "enum", "values": ["down", "up", "left", "right"], "label": "arrow 变体箭头方向（默认 down）" }
      },
      "cues": { "count": 2, "meaning": ["按钮/文字入场", "点击 / 箭头猛推 / 上滑"] },
      "minDur": 2.5, "tail": 1.4, "idle": true,
      "variants": ["button", "arrow", "swipe"],
      "variantsNote": "button 胶囊按钮弹入 + 光标点击 + 波纹，之后呼吸 / arrow 文字弹起 + 大箭头描出反复顶出 / swipe 滑轨触点反复上滑"
    },
    "subscribe": {
      "label": "关注 / 三连",
      "use": "求关注、求三连、开铃铛：按钮依次被光标点亮，图标弹跳、数字 +1。items 可自定义 2–3 个按钮",
      "props": {
        "kicker": { "type": "string", "max": 20 },
        "items": { "type": "array", "of": "object", "minItems": 1, "maxItems": 3, "label": "按钮（省略用默认：三连 / 关注 / 订阅 + 铃铛）",
          "props": { "label": { "type": "string", "max": 6, "required": true }, "icon": { "type": "icon", "required": true }, "count": { "type": "integer", "min": 0, "max": 9999998, "label": "当前计数（点亮后 +1，示意）" } } },
        "name": { "type": "string", "max": 12, "label": "频道名" },
        "avatar": { "type": "media", "label": "头像（可省略）" },
        "done": { "type": "string", "max": 6, "label": "点击后文字（默认 已关注 / 已订阅）" }
      },
      "cues": { "count": 2, "meaning": ["按钮入场", "开始点击（依次点亮）"] },
      "minDur": 3.5, "tail": 1.6, "idle": true,
      "variants": ["triple", "follow", "bell"],
      "variantsNote": "triple 圆按钮依次点亮 + +1 + 彩纸 / follow 头像名片、关注按钮变已关注、粉丝数 +1 / bell 订阅变已订阅 + 铃铛阻尼摇摆、声波、角标"
    },
    "countdown": {
      "label": "倒计时",
      "use": "3–10 秒倒数：开奖、开播、限时、揭晓前的紧张感；归零时爆开出现结束语",
      "props": {
        "from": { "type": "integer", "min": 3, "max": 10, "required": true, "label": "从几开始" },
        "label": { "type": "string", "max": 18, "label": "上方说明" },
        "end": { "type": "string", "max": 8, "label": "归零后的文字（默认 GO）" }
      },
      "cues": { "count": 1, "meaning": ["开始倒数（每秒一拍；段落不够长时自动压缩）"] },
      "minDur": 3, "tail": 1.4, "idle": true,
      "variants": ["ring", "flip", "slam"],
      "variantsNote": "ring 圆环每秒倒走、最后三下变暖色 / flip 翻页牌 / slam 巨大数字砸入、上一个冲散"
    },
    "price": {
      "label": "价格 / 优惠",
      "use": "亮出价格与优惠：原价划掉、新价砸入、标签盖章；可带 1–3 个卖点",
      "props": {
        "kicker": { "type": "string", "max": 20 },
        "name": { "type": "string", "max": 14, "label": "商品/套餐名" },
        "price": { "type": "string", "max": 8, "required": true, "label": "新价（如 ¥99、$19.9）" },
        "was": { "type": "string", "max": 10, "label": "原价（会被划掉）" },
        "unit": { "type": "string", "max": 4, "label": "单位（/月、起）" },
        "tag": { "type": "string", "max": 4, "label": "标签（限时、立减）" },
        "feats": { "type": "array", "of": "string", "max": 14, "maxItems": 3, "label": "卖点" }
      },
      "cues": { "count": 3, "meaning": ["吊牌/卡片/爆炸贴入场", "原价划掉 + 新价砸入", "标签盖章（之后卖点依次出现）"] },
      "minDur": 3.5, "tail": 1.6, "idle": true,
      "variants": ["tag", "card", "sale"],
      "variantsNote": "tag 吊牌钟摆摆入 + 扫光 / card 套餐卡、数字逐位滚动、卖点打勾、流光边框 / sale 旋转爆炸贴 + 速度线 + 彩纸"
    },
    "reveal": {
      "label": "揭晓 / 抽奖",
      "use": "悬念揭晓：抽奖结果、答案、排名第一、新品名。鼓点悬念 → 打开 → 彩纸",
      "props": {
        "kicker": { "type": "string", "max": 20 },
        "text": { "type": "string", "max": 10, "required": true, "label": "揭晓的结果" },
        "sub": { "type": "string", "max": 24, "label": "补充一句" },
        "icon": { "type": "icon", "label": "结果上方图标" }
      },
      "cues": { "count": 2, "meaning": ["鼓点悬念开始", "揭晓"] },
      "minDur": 3.5, "tail": 1.8, "idle": true,
      "variants": ["curtain", "card", "box"],
      "variantsNote": "curtain 帘幕颤动后拉开 + 聚光灯 / card 背面卡片越抖越快后三维翻开 + 光芒 / box 礼物盒抖动、盒盖飞起、结果升起"
    }
  }
}
