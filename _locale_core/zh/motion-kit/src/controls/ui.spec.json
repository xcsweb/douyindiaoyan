{
  "controls": {
    "chat": {
      "label": "聊天对话",
      "use": "把一段对话演出来：用户与客服/朋友的聊天、群里的讨论、向 AI 助手提问并得到回答；2–6 条消息逐条出现",
      "props": {
        "title": {
          "type": "string",
          "max": 12,
          "label": "顶栏名字（默认取对方名字 / 群聊 / AI 助手）"
        },
        "messages": {
          "type": "array",
          "of": "object",
          "minItems": 2,
          "maxItems": 6,
          "required": true,
          "label": "消息（按顺序）",
          "props": {
            "who": {
              "type": "enum",
              "values": [
                "left",
                "right"
              ],
              "required": true,
              "label": "left 对方 / right 自己"
            },
            "text": {
              "type": "string",
              "max": 40,
              "required": true,
              "label": "消息文字，*重点* 用星号；ai 变体的回答（left）可到 40 字"
            },
            "name": {
              "type": "string",
              "max": 8,
              "label": "发送者名字（thread 变体显示）"
            },
            "avatar": {
              "type": "media",
              "label": "头像图片（可省略，省略时显示首字母圆）"
            }
          }
        }
      },
      "cues": {
        "count": "messages.length",
        "meaning": [
          "每条消息出现（自己的消息在此刻发送；ai 回答从此刻开始流式输出）"
        ]
      },
      "minDur": 4,
      "tail": 1.6,
      "idle": true,
      "variants": [
        "bubbles",
        "thread",
        "ai"
      ],
      "variantsNote": "bubbles 手机聊天：输入框打字发送 / 对方正在输入三个点后弹出，自动上滚 / thread 宽面板群聊：头像 + 名字 / ai 助手问答：问题发出，回答逐字流式输出"
    },
    "comment": {
      "label": "评论 / 弹幕",
      "use": "展示观众反馈、网友评论、热评、弹幕刷屏：2–5 条评论逐条浮现，点赞数上涨，最高赞那条被强调（热评 / 置顶 / 放大停住）",
      "props": {
        "title": {
          "type": "string",
          "max": 14,
          "label": "评论区标题（cards / pinned，可省略）"
        },
        "items": {
          "type": "array",
          "of": "object",
          "minItems": 2,
          "maxItems": 5,
          "required": true,
          "label": "评论（最高赞的一条会被强调）",
          "props": {
            "user": {
              "type": "string",
              "max": 10,
              "required": true,
              "label": "用户名（示意）"
            },
            "text": {
              "type": "string",
              "max": 30,
              "required": true,
              "label": "评论文字，*重点* 用星号"
            },
            "likes": {
              "type": "integer",
              "min": 0,
              "max": 99999999,
              "label": "点赞数（示意）"
            },
            "time": {
              "type": "string",
              "max": 8,
              "label": "时间，如「2 小时前」"
            },
            "avatar": {
              "type": "media",
              "label": "头像（可省略，省略时显示首字母圆）"
            }
          }
        },
        "src": {
          "type": "media",
          "label": "danmaku 变体：弹幕下面的播放画面（图片/视频，可省略）"
        },
        "sourceStart": {
          "type": "number",
          "min": 0
        }
      },
      "cues": {
        "count": "items.length + 1",
        "meaning": [
          "每条评论出现（弹幕发出）",
          "最高赞那条被强调：盖热评章 / 置顶 / 放大停住"
        ]
      },
      "minDur": 4,
      "tail": 1.8,
      "idle": true,
      "variants": [
        "cards",
        "danmaku",
        "pinned"
      ],
      "variantsNote": "cards 评论卡翻起浮现、点赞数增长、盖热评章 / danmaku 弹幕从右飞过播放画面，热评放大停在中央 / pinned 评论卡落下，最高赞那条被拎起移到最上方置顶"
    },
    "notify": {
      "label": "通知横幅",
      "use": "表现「消息来了」：订单、提醒、私信、系统通知一条接一条弹出；也可做锁屏收到通知的画面",
      "props": {
        "items": {
          "type": "array",
          "of": "object",
          "minItems": 1,
          "maxItems": 4,
          "required": true,
          "label": "通知（按到达顺序）",
          "props": {
            "app": {
              "type": "string",
              "max": 8,
              "required": true,
              "label": "来源名称（中性，如「日程」「消息」）"
            },
            "title": {
              "type": "string",
              "max": 16,
              "required": true,
              "label": "标题"
            },
            "text": {
              "type": "string",
              "max": 30,
              "label": "正文（最多两行）"
            },
            "icon": {
              "type": "icon",
              "label": "图标（默认 bell）"
            },
            "time": {
              "type": "string",
              "max": 6,
              "label": "时间（默认「刚刚」）"
            }
          }
        },
        "time": {
          "type": "string",
          "max": 5,
          "label": "lock 变体：锁屏时间，如 08:30"
        },
        "date": {
          "type": "string",
          "max": 12,
          "label": "lock 变体：锁屏日期，如「10 月 12 日 星期一」"
        }
      },
      "cues": {
        "count": "items.length + 1",
        "meaning": [
          "每条通知到达",
          "收尾：stack 展开成列表 / toast 按下「查看」/ lock 上滑提示"
        ]
      },
      "minDur": 3,
      "tail": 1.6,
      "idle": true,
      "variants": [
        "stack",
        "toast",
        "lock"
      ],
      "variantsNote": "stack 从顶部依次滑下叠成一摞、铃铛角标跳动，最后展开 / toast 中心弹窗依次弹出，最后按下查看 / lock 锁屏亮起、通知滑入、手机震动"
    },
    "search": {
      "label": "搜索框",
      "use": "演示「搜一下」：输入关键词 → 回车 → 联想/结果出现、命中词高亮；适合讲搜索热度、怎么找资料、工具里的命令面板",
      "props": {
        "query": {
          "type": "string",
          "max": 20,
          "required": true,
          "label": "输入的搜索词"
        },
        "placeholder": {
          "type": "string",
          "max": 12,
          "label": "输入前的占位文字（默认「搜索」）"
        },
        "items": {
          "type": "array",
          "of": "object",
          "minItems": 0,
          "maxItems": 5,
          "label": "联想词 / 结果（命中搜索词的部分自动高亮）",
          "props": {
            "text": {
              "type": "string",
              "max": 24,
              "required": true,
              "label": "联想词 / 结果标题"
            },
            "desc": {
              "type": "string",
              "max": 40,
              "label": "说明（spotlight 一行；results 最多两行）"
            },
            "icon": {
              "type": "icon",
              "label": "spotlight 变体的图标"
            }
          }
        }
      },
      "cues": {
        "count": 3,
        "meaning": [
          "开始输入",
          "回车，结果展开",
          "选中 / 打开第一条（最佳匹配）"
        ]
      },
      "minDur": 3.5,
      "tail": 1.6,
      "idle": true,
      "variants": [
        "bar",
        "spotlight",
        "results"
      ],
      "variantsNote": "bar 大搜索框展开、打字、联想列表下拉 / spotlight 背景压暗的居中命令面板、方向键选中后回车 / results 结果页：加载条 + 骨架屏，结果卡片替换骨架，第一条标最佳匹配"
    },
    "browser": {
      "label": "浏览器 / 应用窗口",
      "use": "演示「打开一个网页 / 网站 / 应用」：地址栏输入网址、加载、页面滚动，再用 1–3 个高亮框标出重点区域。只需要静态录屏展示用 0.2.0 的 media",
      "props": {
        "url": {
          "type": "string",
          "max": 32,
          "required": true,
          "label": "网址（示意，如 example.com/docs）"
        },
        "title": {
          "type": "string",
          "max": 16,
          "label": "标签页标题"
        },
        "src": {
          "type": "media",
          "label": "网页截图 / 录屏（可省略，省略时显示占位）"
        },
        "sourceStart": {
          "type": "number",
          "min": 0
        },
        "callouts": {
          "type": "array",
          "of": "object",
          "minItems": 0,
          "maxItems": 3,
          "label": "高亮框（坐标为视口比例 0–1）",
          "props": {
            "x": {
              "type": "number",
              "min": 0,
              "max": 1,
              "label": "左"
            },
            "y": {
              "type": "number",
              "min": 0,
              "max": 1,
              "label": "上"
            },
            "w": {
              "type": "number",
              "min": 0.05,
              "max": 1,
              "label": "宽"
            },
            "h": {
              "type": "number",
              "min": 0.05,
              "max": 1,
              "label": "高"
            },
            "text": {
              "type": "string",
              "max": 14,
              "required": true,
              "label": "标注文字"
            }
          }
        }
      },
      "cues": {
        "count": "2 + callouts.length",
        "meaning": [
          "开始输入网址",
          "页面滚动",
          "每个高亮框描出"
        ]
      },
      "minDur": 4,
      "tail": 1.6,
      "idle": true,
      "variants": [
        "browser",
        "phone",
        "laptop"
      ],
      "variantsNote": "browser 桌面浏览器窗口透视转正 / phone 手机浏览器从下方升起 / laptop 笔记本开盖、屏幕亮起"
    },
    "social": {
      "label": "社交数据卡",
      "use": "展示一条内容的反响：帖子被点赞、主页涨粉、三项互动数据；数字滚动上涨。数字请标注示意",
      "props": {
        "user": {
          "type": "string",
          "max": 12,
          "required": true,
          "label": "账号名（示意）"
        },
        "text": {
          "type": "string",
          "max": 40,
          "label": "帖子文字 / 个人简介 / 数据卡标题（stats 一行）"
        },
        "src": {
          "type": "media",
          "label": "post 配图 / profile 封面（可省略）"
        },
        "sourceStart": {
          "type": "number",
          "min": 0
        },
        "avatar": {
          "type": "media",
          "label": "头像（可省略，省略时显示首字母圆）"
        },
        "time": {
          "type": "string",
          "max": 8,
          "label": "发布时间"
        },
        "likes": {
          "type": "integer",
          "min": 0,
          "max": 9999999999,
          "label": "点赞 / 获赞数"
        },
        "comments": {
          "type": "integer",
          "min": 0,
          "max": 9999999999,
          "label": "评论数"
        },
        "shares": {
          "type": "integer",
          "min": 0,
          "max": 9999999999,
          "label": "转发数"
        },
        "followers": {
          "type": "integer",
          "min": 0,
          "max": 9999999999,
          "label": "profile 变体：粉丝数（默认用 likes）"
        }
      },
      "cues": {
        "count": 2,
        "meaning": [
          "卡片入场",
          "点赞 / 关注 / 数字开始滚动（stats 可再给 3 个 cue 分别对应三个数字）"
        ]
      },
      "minDur": 3.5,
      "tail": 1.8,
      "idle": true,
      "variants": [
        "post",
        "profile",
        "stats"
      ],
      "variantsNote": "post 帖子卡翻起、点赞爱心爆开、三个数字滚动上涨 / profile 个人主页按下关注、粉丝数滚动、+N 飘起 / stats 三个指标并排、数字滚动 + 迷你折线描出"
    },
    "cursor": {
      "label": "鼠标点击演示",
      "use": "演示软件操作步骤：依次点几个按钮、把文件拖进某个区域、打开菜单选一项。可以放截图作为背景",
      "props": {
        "title": {
          "type": "string",
          "max": 14,
          "label": "click 标题 / drag 放置区文字 / menu 选择前的按钮文字"
        },
        "items": {
          "type": "array",
          "of": "object",
          "minItems": 1,
          "maxItems": 4,
          "required": true,
          "label": "按钮 / 卡片 / 菜单项",
          "props": {
            "label": {
              "type": "string",
              "max": 10,
              "required": true
            },
            "icon": {
              "type": "icon"
            }
          }
        },
        "pick": {
          "type": "integer",
          "min": 1,
          "max": 4,
          "label": "menu 变体：最后选中第几项（默认最后一项）"
        },
        "src": {
          "type": "media",
          "label": "背景截图（可省略，压暗显示）"
        },
        "sourceStart": {
          "type": "number",
          "min": 0
        }
      },
      "cues": {
        "count": "items.length",
        "meaning": [
          "click 每次点击 / drag 每张卡片放下 / menu 两个 cue：打开菜单、选中"
        ]
      },
      "minDur": 3.5,
      "tail": 1.2,
      "idle": true,
      "variants": [
        "click",
        "drag",
        "menu"
      ],
      "variantsNote": "click 鼠标沿弧线依次点按钮、波纹 + 打勾 / drag 把卡片逐张拖进放置区 / menu 打开下拉菜单、逐项悬停后选中"
    }
  }
}